# Frontend environment variables
# Copy this file to .env and fill in your values

# URL of the backend API (no trailing slash)
# Leave unset (recommended): the browser talks same-origin to the frontend
# and the Vite dev proxy forwards API calls to the backend — remote/tunneled
# viewing then needs only one forwarded port (5173). Set an absolute URL only
# when the frontend is served from a different host than the backend.
# VITE_API_URL=http://127.0.0.1:8000
