# Copy to .env:  cp backend/.env.example backend/.env

# Public library (gavel-rules on GitHub) — the backend read-syncs rules/CEs
# from the gavel-rules repository. GITHUB_TOKEN is a READ-access token needed
# only while that repo is private (it also lifts GitHub API rate limits);
# leave it blank once the repo is public. There is no in-studio publishing —
# contributions to the library go by pull request to gavel-rules.
# GAVEL_RULES_REPO / GAVEL_RULES_REF point the sync at a different repo or
# branch (defaults below).
GITHUB_TOKEN=
# GAVEL_RULES_REPO=Offensive-AI-Lab/gavel-rules
# GAVEL_RULES_REF=main

# Database — SQLite file, created automatically on first boot. No server, no
# credentials. Optional override; the path is absolute or relative to backend/.
# Delete the file for a clean slate (the library re-syncs from gavel-rules).
# DB_PATH=db/gavel.sqlite3

# Optional — AI generation. Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Remote GPU (optional; default runs on this machine).
# Cluster (BGU): just run  bash cluster/setup_local.sh   (Windows: cluster\setup_local.ps1)
#   — it fills in all the cluster settings here automatically. Nothing to add by hand.
# Own GPU box:  run gavel-gpu-worker (see gavel-gpu-worker/README.md), then set:
# GPU_WORKER_URL=https://<your-worker-host>
# GPU_WORKER_TOKEN=<token you set on the worker>
